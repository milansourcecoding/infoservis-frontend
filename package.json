{
  "name": "InfoSistem",
  "author": "Source Coding",
  "version": "1.0.0",
  "description": "Portal",
  "private": true,
  "scripts": {
    "start": "react-scripts start",
    "start:staging": "set NODE_ENV=staging&&env-cmd -f .env.staging react-scripts --max-old-space-size=16000 start",
    "start:local": "set NODE_ENV=local&&env-cmd -f .env react-scripts --max-old-space-size=16000 start",
    "start:production": "set NODE_ENV=production&&env-cmd -f .env.production react-scripts --max-old-space-size=16000 start",
    "build": "react-scripts build",
    "build:staging": "set NODE_ENV=staging&&env-cmd -f .env.staging react-scripts --max-old-space-size=16000 build",
    "build:production": "set NODE_ENV=production&&env-cmd -f .env.production react-scripts --max-old-space-size=16000 build",
    "version:patch": "npm --no-git-tag-version version patch",
    "version:minor": "npm --no-git-tag-version version minor",
    "version:major": "npm --no-git-tag-version version major",
    "eject": "react-scripts eject",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\"",
    "prettier": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "clear-all": "rm -rf node_modules .next out dist build",
    "re-start": "rm -rf node_modules .next out dist build && yarn install && yarn start",
    "re-build": "rm -rf node_modules .next out dist build && yarn install && yarn build",
    "re-build-test": "rm -rf node_modules .next out dist build && npm install && npm run build"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
